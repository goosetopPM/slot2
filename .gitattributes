# LF everywhere, on every platform. Dockerfiles, shell scripts and taskfiles are read inside
# Linux containers and on the device, where a stray CR breaks them.
* text=auto eol=lf

# Binary assets never get touched.
*.png binary
*.webp binary
*.ttf binary
*.otf binary
*.wav binary
*.so binary
*.gba binary
*.gb binary
*.gbc binary
*.nes binary
*.sfc binary
*.smc binary
*.md.bin binary
*.sms binary

# These two are byte-preserved upstream licence texts: their trailing spaces are part of the
# upstream releases, so Git must not report them as whitespace errors when they are staged.
licenses/cores/genesis_plus_gx/LICENSE.txt -whitespace
licenses/cores/mgba/LICENSE -whitespace
